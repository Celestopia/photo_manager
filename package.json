{
  "name": "photo-manager",
  "productName": "Photo Manager",
  "version": "0.40.4",
  "description": "Local image and video manager built with Electron and Vue",
  "author": "Photo Manager",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run build:renderer && node scripts/start-electron.js",
    "build:renderer": "vite build --config vite.config.mjs",
    "pack:win": "npm run build:renderer && electron-builder --dir --win --x64",
    "dist:win": "npm test && npm run pack:win",
    "build-thumbnails": "node scripts/build-thumbnails.js",
    "build-video-covers": "node scripts/build-video-covers.js",
    "init-metadata": "node scripts/init-metadata.js",
    "update-metadata": "node scripts/update-metadata.js",
    "verify-metadata": "node scripts/verify-metadata.js",
    "export-metadata-csv": "node scripts/export-metadata-csv.js",
    "test": "node --test \"tests/*.test.js\" \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "geo-tz": "^8.1.8",
    "js-yaml": "^4.3.2",
    "leaflet": "1.9.4",
    "markdown-it": "^15.0.1",
    "sharp": "^0.35.4"
  }
}
