{
  "name": "photo-manager",
  "productName": "Photo Manager",
  "version": "0.41.0",
  "description": "Local image and video manager with desktop and command-line applications",
  "author": "Photo Manager",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run build:renderer && node scripts/start-electron.js",
    "build:renderer": "vite build --config vite.config.mjs",
    "pack:gui": "npm run build:renderer && node scripts/pack-gui.cjs",
    "pack:cli": "node scripts/pack-cli.cjs",
    "pack:win": "npm run pack:gui && npm run pack:cli",
    "dist:win": "npm test && npm run pack:win",
    "cli": "node src/cli/main.js",
    "test": "node --test \"tests/*.test.js\" \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "postject": "1.0.0-alpha.6",
    "resedit": "1.7.2",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "geo-tz": "^8.1.8",
    "js-yaml": "^4.3.2",
    "leaflet": "1.9.4",
    "markdown-it": "^15.0.1",
    "sharp": "^0.35.4"
  }
}
